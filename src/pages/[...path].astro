---
import { getCollection } from 'astro:content';
import Article from '@/components/Article.astro';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { getPostUrl } from '@/utils/getPostPaths';
import archives from '@/data/legacy-pages.json';
import { getSortedPosts } from '@/utils/getSortedPosts';

export async function getStaticPaths() {
  const posts = getSortedPosts(await getCollection('posts'));
  return [
    ...posts.map(post => ({ params: { path: getPostUrl(post.id, post.filePath).replace(/^\//, '').replace(/\/$/, '') }, props: { kind: 'article' as const, post } })),
    ...archives.map(page => ({ params: { path: page.url.replace(/^\//, '').replace(/\/$/, '') }, props: { kind: 'archive' as const, page } })),
  ];
}
const props = Astro.props;
---
{props.kind === 'article' ? <Article post={props.post} /> : (
  <Layout title={`${props.page.title} | Archive`}>
    <Header />
    <main id="main-content" class="app-layout app-prose my-12">
      <h1>{props.page.title}</h1>
      <p>This URL belonged to a page from the original site template. Sample biographies, publications, talks, and teaching records are template examples, not personal career claims.</p>
      <p>The original content is preserved as a <a href={props.page.source}>source document</a>.</p>
      <p><a href="/writing/">Read the writing</a> or <a href="/projects/">view projects</a>.</p>
    </main>
    <Footer />
  </Layout>
)}

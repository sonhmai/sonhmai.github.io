---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Card from '@/components/Card.astro';
import { getSortedPosts } from '@/utils/getSortedPosts';
const posts = getSortedPosts(await getCollection('posts'));
---
<Layout title="Writing | Son's blog">
  <Header />
  <main id="main-content" class="app-layout my-12">
    <h1 class="text-3xl font-bold">Writing</h1>
    <p class="mt-4">Articles and reading notes on software, databases, and distributed systems.</p>
    <h2 class="mt-10 text-xl font-semibold">Articles</h2>
    <ul>{posts.filter(post => !post.data.note).map(post => <Card {...post} />)}</ul>
    <h2 class="mt-10 text-xl font-semibold">Paper notes</h2>
    <ul>{posts.filter(post => post.data.note).map(post => <Card {...post} />)}</ul>
  </main>
  <Footer />
</Layout>
